{
  "nodeModulesDir": "auto",
  "unstable": ["kv", "cron"],
  "tasks": {
    "scrape": "deno run --allow-net --allow-read --allow-write bmw_scraper.ts",
    "analyze": "deno run --allow-net --allow-read --allow-write analyzer.ts",
    "cron": "deno run --allow-net --allow-read --allow-write main.ts",
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "deno run -A --watch=static/,routes/ dev.ts",
    "build": "deno run -A dev.ts build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update .",
    "test:discord": "deno run --allow-net --allow-env tests/test_discord.ts",
    "test:diff": "deno run --allow-net --allow-env --unstable-kv tests/simulate_diff.ts"
}
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*"
  ],
  "imports": {
    "fresh": "jsr:@fresh/core@^2.0.0-alpha.60",
    "preact": "npm:preact@^10.27.1",
    "@preact/signals": "npm:@preact/signals@^2.3.1",
    "tutti-api": "npm:tutti-api@^2.1.1"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head"
    ]
  }
}